# --- API ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
ENABLE_DOCS=true
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MIN=300

DATABASE_URL=postgresql://coach:coach@localhost:5432/coach?schema=public&connection_limit=10
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Object storage (MinIO locally, S3 in production) ---
S3_REGION=ap-southeast-1
S3_BUCKET=coach-media
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
PRESIGN_TTL_SEC=900

# --- Media limits ---
MEDIA_MAX_IMAGE_BYTES=20971520
MEDIA_MAX_VIDEO_BYTES=2147483648
MULTIPART_THRESHOLD_BYTES=52428800
MULTIPART_PART_SIZE=10485760

# --- Worker ---
WORKER_CONCURRENCY=2
